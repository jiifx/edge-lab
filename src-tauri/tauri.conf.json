{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Edge Lab",
  "version": "2.18.1",
  "identifier": "com.jiidc.propedgelab2",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Edge Lab",
        "width": 1360,
        "height": 840,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/128x128.png"],
    "resources": { "../guide/Edge Lab - User Manual.pdf": "Edge Lab - User Manual.pdf" },
    "macOS": {
      "minimumSystemVersion": "11.3",
      "dmg": { "windowSize": { "width": 660, "height": 420 } }
    },
    "windows": {
      "nsis": { "installerHooks": "./windows/hooks.nsh" }
    },
    "category": "Finance",
    "publisher": "jiidc",
    "copyright": "(c) 2026 jiidc. MIT licensed.",
    "shortDescription": "Trading journal + edge simulator",
    "longDescription": "Edge Lab: trade journal and Monte Carlo edge simulator, with an optional prop-firm mode. Offline, no accounts. Produced by jiidc."
  }
}
